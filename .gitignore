__pycache__/
*.py[cod]
.venv/
.uv-cache/
.pycache/
.tmp/
.ruff_cache/
review.json
# review.html 同样是 flow.sh review 的生成物，但对外可直接当只读审阅页浏览，
# 故随仓库提交；改译稿后需重新生成。review.json 与它内容重复且更大，继续忽略。
/patcher/FarlandSagaPatcher*.exe
/patcher/farland-saga-patcher

# 内嵌补丁由 build-patcher 从 work/release 复制而来，属于私有工作区产物
/patcher/payload/*.zip

# 只保留 Unifont 的 gzip 字形表与授权文件。未压缩 .hex 与它逐字节一致，
# 官方 tar.gz 仅作溯源，三者都会进 git 历史让仓库永久变大。
/fonts/unifont-18.0.01/unifont-18.0.01.hex
/fonts/unifont-18.0.01/unifont-18.0.01.tar.gz

# 私有工作区约定：游戏数据、候选、备份与存储都放这里，不进入公开仓库
/work/
